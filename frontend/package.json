{
  "name": "nexuslink-frontend",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
