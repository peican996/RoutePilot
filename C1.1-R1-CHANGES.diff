+	w.Pause()
+	w.ReportExit(ExitInfo{Reason: "boom again", At: time.Now()})
+	time.Sleep(90 * time.Millisecond)
+	if got := atomic.LoadInt32(&calls); got != 0 {
+		t.Fatalf("Pause 后仍重启了 %d 次", got)
+	}
+	if watchdogHasTimer(w) {
+		t.Fatal("Pause 后不应残留定时器")
+	}
