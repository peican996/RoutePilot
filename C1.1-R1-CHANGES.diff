+	var calls int32
+	w := NewWatchdog(WatchdogOptions{
+		Config: WatchdogConfig{
+			Window:      time.Hour,
+			MaxRestarts: 5,
+			BaseDelay:   40 * time.Millisecond,
+			MaxDelay:    time.Second,
+			StableAfter: time.Hour,
