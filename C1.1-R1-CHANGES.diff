+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	t.Fatal("Resume 后未恢复自动重启")
+}
+
+func waitCalls(t *testing.T, calls <-chan struct{}, n int) {
+	t.Helper()
+	for i := 0; i < n; i++ {
+		select {
+		case <-calls:
+		case <-time.After(2 * time.Second):
+			t.Fatalf("等待第 %d 次重启超时", i+1)
+		}
+	}
+}
