+// 恢复失败后用户又设置了新的代理：再次恢复必须放弃，不得覆盖用户配置。
+func TestR1ExternalChangeAfterFailedRestoreIsNotOverwritten(t *testing.T) {
+	fake := &fakeRegistry{
