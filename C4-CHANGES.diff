+package main
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// 损坏配置必须：保留原文件（改名备份）、记录可诊断错误、不得静默当作空配置。
+func TestCorruptConfigIsPreservedAndReported(t *testing.T) {
+	cases := []struct {
+		name   string
+		file   string
+		body   string
+		load   func(*CoreService)
+		verify func(*testing.T, *CoreService)
+	}{
+		{
+			name: "app-state 非法 JSON",
+			file: appStateFile,
+			body: `{"tun": true, "mode": `,
+			load: (*CoreService).loadAppState,
+			verify: func(t *testing.T, s *CoreService) {
+				s.mu.RLock()
+				mode := s.mode
+				s.mu.RUnlock()
+				if mode != "rule" {
+					t.Fatalf("损坏后应回退 rule 模式，实际 %q", mode)
+				}
+			},
+		},
+		{
+			name: "app-state 字段类型非法",
+			file: appStateFile,
+			body: `{"tun": "yes"}`,
+			load: (*CoreService).loadAppState,
+		},
+		{
+			name: "app-state 截断",
+			file: appStateFile,
+			body: `{"tun": true, "proxyOn":`,
+			load: (*CoreService).loadAppState,
+		},
+		{
+			name: "subs 损坏",
+			file: subsFile,
+			body: `{"items": [{"url": `,
+			load: (*CoreService).loadSubs,
+			verify: func(t *testing.T, s *CoreService) {
+				s.mu.RLock()
+				n := len(s.subs)
+				s.mu.RUnlock()
+				if n != 0 {
+					t.Fatalf("损坏订阅不应被加载: %d", n)
+				}
+			},
+		},
+		{
+			name: "proc-rules 损坏",
+			file: procRulesJSON,
+			body: `{"name:chrome.exe": `,
+			load: (*CoreService).loadProcRules,
+		},
+		{
+			name: "site-rules 损坏",
+			file: siteRulesJSON,
+			body: `[{"domain": "example.com",`,
+			load: (*CoreService).loadSiteRules,
+		},
+		{
+			name: "ignored 损坏",
+			file: procIgnoredJSON,
+			body: `["chrome.exe"`,
+			load: (*CoreService).loadIgnored,
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			svc := configTestService(t)
+			path := filepath.Join(dataDir(), tc.file)
+			if err := os.WriteFile(path, []byte(tc.body), 0o600); err != nil {
+				t.Fatal(err)
+			}
+
+			tc.load(svc)
+
+			if _, err := os.Stat(path); !os.IsNotExist(err) {
+				t.Fatal("损坏文件必须被移走，避免后续保存覆盖原始内容")
+			}
+			backups, _ := filepath.Glob(path + ".corrupt-*")
+			if len(backups) != 1 {
+				t.Fatalf("应生成一个损坏备份，实际 %d", len(backups))
+			}
+			data, err := os.ReadFile(backups[0])
+			if err != nil || string(data) != tc.body {
+				t.Fatalf("备份内容与原文件不一致: %q", data)
+			}
+			svc.mu.RLock()
+			bootErr := svc.bootErr
+			svc.mu.RUnlock()
+			if !strings.Contains(bootErr, filepath.Base(path)) {
+				t.Fatalf("启动错误应指明损坏文件，实际 %q", bootErr)
+			}
+			if tc.verify != nil {
+				tc.verify(t, svc)
+			}
+		})
+	}
+}
+
+// 空文件按截断处理，同样保留并提示。
+func TestEmptyConfigIsTreatedAsCorrupt(t *testing.T) {
+	svc := configTestService(t)
+	path := filepath.Join(dataDir(), appStateFile)
+	if err := os.WriteFile(path, []byte("   \n\t"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	svc.loadAppState()
+	if _, err := os.Stat(path); !os.IsNotExist(err) {
+		t.Fatal("空配置文件必须被保留为备份")
+	}
+	if backups, _ := filepath.Glob(path + ".corrupt-*"); len(backups) != 1 {
+		t.Fatal("空配置文件应生成备份")
+	}
+	svc.mu.RLock()
+	bootErr := svc.bootErr
+	svc.mu.RUnlock()
+	if !strings.Contains(bootErr, "内容为空") {
+		t.Fatalf("错误信息应区分空文件，实际 %q", bootErr)
+	}
+}
+
+// 版本高于当前程序：不得按旧结构解释，也不得覆盖。
+func TestFutureVersionConfigIsRejected(t *testing.T) {
+	svc := configTestService(t)
+	path := filepath.Join(dataDir(), appStateFile)
+	if err := os.WriteFile(path, []byte(`{"version": 99, "tun": true}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	svc.loadAppState()
+
+	if _, err := os.Stat(path); !os.IsNotExist(err) {
+		t.Fatal("未来版本配置必须被移走")
+	}
+	svc.mu.RLock()
+	bootErr := svc.bootErr
+	tun := svc.tunOn
+	svc.mu.RUnlock()
+	if !strings.Contains(bootErr, "版本") {
+		t.Fatalf("应提示版本不兼容，实际 %q", bootErr)
+	}
+	if tun {
+		t.Fatal("不能按未来版本配置开启 TUN")
+	}
+}
+
+// 文件不存在属于正常首次启动：不提示、不产生备份。
+func TestMissingConfigIsNormal(t *testing.T) {
+	svc := configTestService(t)
+	svc.loadAppState()
+	svc.loadSubs()
+	svc.loadProcRules()
+	svc.loadSiteRules()
+	svc.loadIgnored()
+
+	svc.mu.RLock()
+	bootErr := svc.bootErr
+	svc.mu.RUnlock()
+	if bootErr != "" {
+		t.Fatalf("首次启动不应有配置错误: %q", bootErr)
+	}
+	entries, _ := filepath.Glob(filepath.Join(dataDir(), "*.corrupt-*"))
+	if len(entries) != 0 {
+		t.Fatalf("首次启动不应产生损坏备份: %v", entries)
+	}
+}
+
+// 损坏文件被保留后，后续保存只能写入新文件，不能破坏备份。
+func TestSaveAfterCorruptDoesNotDestroyBackup(t *testing.T) {
+	svc := configTestService(t)
+	path := filepath.Join(dataDir(), appStateFile)
+	bad := `{"tun": true,`
+	if err := os.WriteFile(path, []byte(bad), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	svc.loadAppState()
+	backups, _ := filepath.Glob(path + ".corrupt-*")
+	if len(backups) != 1 {
+		t.Fatal("应生成损坏备份")
+	}
+
+	svc.saveAppState()
+
+	got, err := os.ReadFile(backups[0])
+	if err != nil || string(got) != bad {
+		t.Fatalf("备份被后续保存破坏: %q", got)
+	}
+	fresh, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal("保存应生成新的配置文件")
+	}
+	if !strings.Contains(string(fresh), `"version": 1`) {
+		t.Fatalf("新配置应带当前版本号: %s", fresh)
+	}
+}
+
+func configTestService(t *testing.T) *CoreService {
+	t.Helper()
+	old := dataDirOverride
+	dataDirOverride = t.TempDir()
+	t.Cleanup(func() { dataDirOverride = old })
+	return NewCoreService()
+}
diff --git a/c4_procgen_test.go b/c4_procgen_test.go
new file mode 100644
index 0000000..6f653a5
--- /dev/null
+++ b/c4_procgen_test.go
@@ -0,0 +1,235 @@
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+var errTestInjected = errors.New("injected failure")
+
+func procGenTestService(t *testing.T) *CoreService {
+	t.Helper()
+	old := dataDirOverride
+	dataDirOverride = t.TempDir()
+	t.Cleanup(func() { dataDirOverride = old })
+	return NewCoreService()
+}
+
+func sampleProcRules() map[string]string {
+	return map[string]string{
+		"name:chrome.exe":  "direct",
+		"name:firefox.exe": "proxy",
+	}
+}
+
+// 发布后必须能解析出同一代三个文件，且 options() 使用 procgen 路径。
+func TestProcGenPublishAndResolve(t *testing.T) {
+	svc := procGenTestService(t)
+	rules := sampleProcRules()
+	if err := svc.publishProcRules(rules); err != nil {
+		t.Fatalf("发布失败: %v", err)
+	}
+
+	paths, got, ok := svc.resolvePublishedProcRules()
+	if !ok {
+		t.Fatal("应能解析出已发布版本")
+	}
+	if len(got) != len(rules) || got["name:chrome.exe"] != "direct" {
+		t.Fatalf("规则内容不符: %+v", got)
+	}
+	for _, p := range []string{paths.Proxy, paths.Direct, paths.Rules} {
+		if _, err := os.Stat(p); err != nil {
+			t.Fatalf("发布文件缺失 %s: %v", p, err)
+		}
+	}
+
+	opt := svc.options()
+	if !strings.HasPrefix(opt.ProcessProxyPath, "./procgen/") ||
+		!strings.HasPrefix(opt.ProcessDirectPath, "./procgen/") {
+		t.Fatalf("options 未使用 procgen 路径: %q %q", opt.ProcessProxyPath, opt.ProcessDirectPath)
+	}
+}
+
+// 写完文件但 manifest 发布失败：current.json 不变，旧版本继续可用。
+func TestProcGenManifestFailureKeepsPrevious(t *testing.T) {
+	svc := procGenTestService(t)
+	v1 := map[string]string{"name:chrome.exe": "direct"}
+	if err := svc.publishProcRules(v1); err != nil {
+		t.Fatal(err)
+	}
+
+	origHook := procPublishHook
+	t.Cleanup(func() { procPublishHook = origHook })
+	procPublishHook = func(stage string) error {
+		if stage == "before-manifest" {
+			return errTestInjected
+		}
+		return nil
+	}
+
+	if err := svc.publishProcRules(map[string]string{"name:chrome.exe": "proxy"}); err == nil {
+		t.Fatal("manifest 发布失败时 publish 必须报错")
+	}
+	procPublishHook = origHook
+
+	_, got, ok := svc.resolvePublishedProcRules()
+	if !ok {
+		t.Fatal("旧版本应继续可用")
+	}
+	if got["name:chrome.exe"] != "direct" {
+		t.Fatalf("解析到未提交的新版本: %+v", got)
+	}
+}
+
+// current.json 损坏：回退上一代 manifest。
+func TestProcGenCorruptManifestFallsBackPrev(t *testing.T) {
+	svc := procGenTestService(t)
+	if err := svc.publishProcRules(map[string]string{"name:a.exe": "direct"}); err != nil {
+		t.Fatal(err)
+	}
+	if err := svc.publishProcRules(map[string]string{"name:a.exe": "proxy"}); err != nil {
+		t.Fatal(err)
+	}
+
+	cur := filepath.Join(procGenDir(), procGenManifestName)
+	if err := os.WriteFile(cur, []byte("{broken"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	_, got, ok := svc.resolvePublishedProcRules()
+	if !ok {
+		t.Fatal("应回退到上一代")
+	}
+	if got["name:a.exe"] != "direct" {
+		t.Fatalf("回退版本内容不符: %+v", got)
+	}
+
+	// 再启动时 loadProcRules 也不能被损坏 manifest 影响。
+	svc2 := procGenTestServiceAt(t, dataDir())
+	svc2.loadProcRules()
+	svc2.mu.RLock()
+	rules := svc2.procRules
+	svc2.mu.RUnlock()
+	if rules["name:a.exe"] != "direct" {
+		t.Fatalf("启动加载未回退: %+v", rules)
+	}
+}
+
+// 某一代文件被截断：哈希校验失败，回退上一代。
+func TestProcGenTruncatedFileFallsBack(t *testing.T) {
+	svc := procGenTestService(t)
+	if err := svc.publishProcRules(map[string]string{"name:a.exe": "direct"}); err != nil {
+		t.Fatal(err)
+	}
+	if err := svc.publishProcRules(map[string]string{"name:a.exe": "proxy"}); err != nil {
+		t.Fatal(err)
+	}
+
+	cur := filepath.Join(procGenDir(), procGenManifestName)
+	mb, err := os.ReadFile(cur)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var m procGenManifest
+	if err := json.Unmarshal(mb, &m); err != nil {
+		t.Fatal(err)
+	}
+	// 模拟写一半崩溃：把最新一代的 proxy 文件截断。
+	if err := os.WriteFile(filepath.Join(procGenDir(), m.Proxy), []byte("PROCESS-NAME,a.exe"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	_, got, ok := svc.resolvePublishedProcRules()
+	if !ok {
+		t.Fatal("应回退到上一代")
+	}
+	if got["name:a.exe"] != "direct" {
+		t.Fatalf("截断后仍使用了不完整版本: %+v", got)
+	}
+}
+
+// 没有 generation 时回退旧版平铺文件，升级前数据不能丢。
+func TestLoadProcRulesFallsBackToLegacy(t *testing.T) {
+	svc := procGenTestService(t)
+	legacy := filepath.Join(dataDir(), procRulesJSON)
+	if err := os.WriteFile(legacy, []byte(`{"name:chrome.exe":"direct"}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	svc.loadProcRules()
+
+	svc.mu.RLock()
+	rules := svc.procRules
+	proxyPath := svc.procProxyPath
+	svc.mu.RUnlock()
+	if rules["name:chrome.exe"] != "direct" {
+		t.Fatalf("旧版规则未加载: %+v", rules)
+	}
+	if proxyPath != procProxyYAML {
+		t.Fatalf("旧版回退路径不符: %s", proxyPath)
+	}
+}
+
+// 多次发布后只保留当前与上一代，避免无限增长。
+func TestProcGenCleanupKeepsTwoGenerations(t *testing.T) {
+	svc := procGenTestService(t)
+	for i := 0; i < 4; i++ {
+		if err := svc.publishProcRules(map[string]string{"name:a.exe": "direct"}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	entries, err := os.ReadDir(procGenDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	names := make([]string, 0, len(entries))
+	for _, e := range entries {
+		names = append(names, e.Name())
+	}
+	names = sortGenFiles(names)
+	// 2 代 × 3 个文件 + current + prev = 8。
+	if len(names) > 8 {
+		t.Fatalf("旧 generation 未清理: %v", names)
+	}
+}
+
+// manifest 被手工改成路径穿越：必须拒绝，不能读取 procgen 目录外的文件。
+func TestProcGenRejectsPathTraversalManifest(t *testing.T) {
+	svc := procGenTestService(t)
+	if err := svc.publishProcRules(map[string]string{"name:a.exe": "direct"}); err != nil {
+		t.Fatal(err)
+	}
+	cur := filepath.Join(procGenDir(), procGenManifestName)
+	mb, err := os.ReadFile(cur)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var m procGenManifest
+	if err := json.Unmarshal(mb, &m); err != nil {
+		t.Fatal(err)
+	}
+	bad := m
+	bad.Proxy = "../outside.yaml"
+	badBytes, _ := json.Marshal(bad)
+	if err := os.WriteFile(cur, badBytes, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	// 同时移除 prev，确保回退路径也不可用，验证的是"拒绝"而不是"回退"。
+	_ = os.Remove(cur + ".prev")
+
+	if _, _, ok := svc.resolvePublishedProcRules(); ok {
+		t.Fatal("路径穿越的 manifest 必须被拒绝")
+	}
+}
+
+func procGenTestServiceAt(t *testing.T, dir string) *CoreService {
+	t.Helper()
+	old := dataDirOverride
+	dataDirOverride = dir
+	t.Cleanup(func() { dataDirOverride = old })
+	return NewCoreService()
+}
