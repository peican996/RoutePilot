new file mode 100644
index 0000000..f8a605b
--- /dev/null
+++ b/c4_subscription_test.go
@@ -0,0 +1,178 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"routepilot/internal/subscription"
+)
+
+const testSubYAML = "proxies:\n" +
+	"  - name: n1\n    type: ss\n    server: 1.2.3.4\n    port: 443\n" +
+	"    cipher: aes-128-gcm\n    password: x\n"
+
+// setupTwoSubs 构造两个已保存订阅（A 为激活），用于验证事务串行化。
+func setupTwoSubs(t *testing.T) (*CoreService, string, string) {
+	t.Helper()
+	old := dataDirOverride
+	dataDirOverride = t.TempDir()
+	t.Cleanup(func() { dataDirOverride = old })
+
+	svc := NewCoreService()
+	urlA := "https://a.example/sub?token=AAA"
+	urlB := "https://b.example/sub?token=BBB"
+	for _, u := range []string{urlA, urlB} {
+		res, err := subscription.Parse([]byte(testSubYAML), u, false)
+		if err != nil {
+			t.Fatalf("构造订阅失败: %v", err)
+		}
+		if err := svc.writeSubscriptionFiles(u, res); err != nil {
+			t.Fatalf("写订阅文件失败: %v", err)
+		}
+	}
+	svc.subs = []subMeta{{URL: urlA}, {URL: urlB}}
+	svc.activeIdx = 0
+	svc.subURL = urlA
+	return svc, urlA, urlB
+}
+
+// 刷新 A 的下载尚未返回时用户切到 B：刷新提交必须放弃，不能把 B 覆盖回去。
+func TestRefreshDoesNotOverrideConcurrentSwitch(t *testing.T) {
+	svc, _, urlB := setupTwoSubs(t)
+
+	fetchStarted := make(chan struct{})
+	releaseFetch := make(chan struct{})
+	var once sync.Once
+	origFetch := fetchSubscription
+	t.Cleanup(func() { fetchSubscription = origFetch })
+	fetchSubscription = func(_ context.Context, u string, _ bool) (*subscription.Result, error) {
+		once.Do(func() { close(fetchStarted) })
+		<-releaseFetch
+		return subscription.Parse([]byte(testSubYAML), u, false)
+	}
+
+	refreshDone := make(chan error, 1)
+	go func() { refreshDone <- svc.RefreshSubscription() }()
+
+	select {
+	case <-fetchStarted:
+	case <-time.After(3 * time.Second):
+		t.Fatal("刷新未进入网络阶段")
+	}
+
+	// 下载期间切换订阅：此时 subsMu 未被占用。
+	if err := svc.SwitchSubscription(1); err != nil {
+		t.Fatalf("切换订阅失败: %v", err)
+	}
+	if got := svc.currentSubURL(); got != urlB {
+		t.Fatalf("切换后激活订阅应为 B，实际 %s", got)
+	}
+
+	close(releaseFetch)
+	select {
+	case err := <-refreshDone:
+		if !errors.Is(err, errSubscriptionChanged) {
+			t.Fatalf("期望 errSubscriptionChanged，实际 %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("刷新未返回")
+	}
+
+	if got := svc.currentSubURL(); got != urlB {
+		t.Fatalf("刷新结果覆盖了用户切换: %s", got)
+	}
+	if svc.subs[svc.activeIdx].URL != urlB {
+		t.Fatal("激活下标与 subURL 不一致")
+	}
+}
+
+// 并发刷新/切换/删除不能死锁，且最终状态内部一致。
+func TestSubscriptionOpsConcurrentConsistency(t *testing.T) {
+	svc, urlA, urlB := setupTwoSubs(t)
+
+	resA, _ := subscription.Parse([]byte(testSubYAML), urlA, false)
+	resB, _ := subscription.Parse([]byte(testSubYAML), urlB, false)
+
+	var wg sync.WaitGroup
+	for i := 0; i < 4; i++ {
+		wg.Add(1)
+		url := urlA
+		res := resA
+		if i%2 == 1 {
+			url, res = urlB, resB
+		}
+		go func() {
+			defer wg.Done()
+			_ = svc.applySubscription(url, res)
+		}()
+	}
+	for i := 0; i < 3; i++ {
+		wg.Add(1)
+		idx := i % 2
+		go func() {
+			defer wg.Done()
+			_ = svc.SwitchSubscription(idx)
+		}()
+	}
+
+	done := make(chan struct{})
+	go func() {
+		wg.Wait()
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(10 * time.Second):
+		t.Fatal("并发订阅操作死锁")
+	}
+
+	svc.mu.RLock()
+	active := svc.subURL
+	idx := svc.activeIdx
+	count := len(svc.subs)
+	config := svc.subConfig
+	svc.mu.RUnlock()
+	if count != 2 {
+		t.Fatalf("并发提交产生了重复/丢失条目: %d", count)
+	}
+	if active != urlA && active != urlB {
+		t.Fatalf("激活订阅异常: %s", active)
+	}
+	if config == nil {
+		t.Fatal("激活订阅的配置不应为空")
+	}
+	if idx < 0 || idx >= count {
+		t.Fatalf("激活下标越界: idx=%d count=%d", idx, count)
+	}
+	svc.mu.RLock()
+	activeOK := svc.subs[idx].URL == active
+	svc.mu.RUnlock()
+	if !activeOK {
+		t.Fatalf("激活下标与激活地址不一致: idx=%d active=%s", idx, active)
+	}
+}
+
+// 删除非激活订阅不改变当前激活配置。
+func TestRemoveInactiveKeepsActive(t *testing.T) {
+	svc, urlA, _ := setupTwoSubs(t)
+	svc.mu.Lock()
+	svc.activeIdx = 0
+	svc.subURL = urlA
+	svc.mu.Unlock()
+
+	if err := svc.RemoveSubscription(1); err != nil {
+		t.Fatalf("删除非激活订阅失败: %v", err)
+	}
+	if got := svc.currentSubURL(); got != urlA {
+		t.Fatalf("删除非激活订阅后激活项被改变: %s", got)
+	}
+	svc.mu.RLock()
+	n := len(svc.subs)
+	svc.mu.RUnlock()
+	if n != 1 {
+		t.Fatalf("剩余订阅数应为 1，实际 %d", n)
+	}
+}
diff --git a/c4_tun_test.go b/c4_tun_test.go
new file mode 100644
index 0000000..f10dcea
--- /dev/null
+++ b/c4_tun_test.go
@@ -0,0 +1,250 @@
+package main
+
+import (
+	"errors"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// 准备一个"系统代理正由本程序接管"的服务。
+func tunService(t *testing.T, fake *fakeRegistry) *CoreService {
+	t.Helper()
+	svc := newC1Service(t, fake)
+	cp := proxyBackup{
+		Addr: "127.0.0.1:17890", Server: "127.0.0.1:8080",
+		Override: "old-bypass", Enabled: true, Saved: true,
+	}
+	svc.proxyOn = true
+	svc.backup = cp
+	writeState(t, svc, cp)
+	return svc
+}
+
+// TUN 开启事务进行到"内核重启"阶段时，并发的 SetSystemProxy(true) 必须被拒绝，
+// 否则会出现 TUN 与系统代理同时接管的双接管状态。
+func TestTUNToggleBlocksConcurrentProxyEnable(t *testing.T) {
+	fake := &fakeRegistry{server: "127.0.0.1:17890", enabled: true, override: "ours"}
+	svc := tunService(t, fake)
+
+	restartEntered := make(chan struct{})
+	releaseRestart := make(chan struct{})
+	var once sync.Once
+	restart := func() error {
+		once.Do(func() { close(restartEntered) })
+		<-releaseRestart
+		return nil
+	}
+
+	tunDone := make(chan error, 1)
+	go func() { tunDone <- svc.setTUN(true, restart) }()
+
+	select {
+	case <-restartEntered:
+	case <-time.After(3 * time.Second):
+		t.Fatal("TUN 事务未进入内核重启阶段")
+	}
+
+	// 此时注册表已关闭、tunOn 尚未提交，但 tunChanging=true。
+	beforeEnable := fake.enableCalls
+	if err := svc.SetSystemProxy(true); err == nil {
+		t.Fatal("TUN 切换期间必须拒绝开启系统代理")
+	}
+	if fake.enableCalls != beforeEnable {
+		t.Fatal("被拒绝的请求不能写注册表")
+	}
+
+	close(releaseRestart)
+	if err := <-tunDone; err != nil {
+		t.Fatalf("TUN 开启失败: %v", err)
+	}
+
+	svc.mu.RLock()
+	tunOn, proxyOn, changing := svc.tunOn, svc.proxyOn, svc.tunChanging
+	svc.mu.RUnlock()
+	if !tunOn || proxyOn || changing {
+		t.Fatalf("提交状态不符: tunOn=%v proxyOn=%v changing=%v", tunOn, proxyOn, changing)
+	}
+	if fake.enabled {
+		t.Fatal("TUN 已开启时系统代理必须保持关闭")
+	}
+	if err := svc.SetSystemProxy(true); err == nil {
+		t.Fatal("TUN 已开启后仍应拒绝开启系统代理")
+	}
+}
+
+// TUN 开启失败：必须回滚到"切换前"的系统代理接管状态。
+func TestTUNEnableFailureRestoresProxyTakeover(t *testing.T) {
+	fake := &fakeRegistry{server: "127.0.0.1:17890", enabled: true, override: "ours"}
+	svc := tunService(t, fake)
+
+	err := svc.setTUN(true, func() error { return errors.New("injected restart failure") })
+	if err == nil {
+		t.Fatal("内核重启失败时 SetTUN 必须报错")
+	}
+
+	svc.mu.RLock()
+	tunOn, proxyOn, bk, changing := svc.tunOn, svc.proxyOn, svc.backup, svc.tunChanging
+	svc.mu.RUnlock()
+	if tunOn {
+		t.Fatal("失败后不能宣称 TUN 已开启")
+	}
+	if changing {
+		t.Fatal("失败后必须清除切换中标记")
+	}
+	if !proxyOn || !bk.Saved {
+		t.Fatalf("失败后应重新接管系统代理: proxyOn=%v backupSaved=%v", proxyOn, bk.Saved)
+	}
+	if !fake.enabled || fake.server != "127.0.0.1:17890" {
+		t.Fatalf("系统代理未恢复到本程序地址: enabled=%v server=%s", fake.enabled, fake.server)
+	}
+}
+
+// 切 TUN 前恢复系统代理失败：必须保留 Pending 备份，交给下次启动重试。
+func TestTUNEnableRestoreFailureKeepsPendingBackup(t *testing.T) {
+	fake := &fakeRegistry{
+		server:          "127.0.0.1:17890",
+		enabled:         true,
+		override:        "ours",
+		failSetOverride: true,
+	}
+	svc := tunService(t, fake)
+
+	restartCalled := int32(0)
+	err := svc.setTUN(true, func() error {
+		atomic.AddInt32(&restartCalled, 1)
+		return nil
+	})
+	if !errors.Is(err, errTUNRestoreFailed) {
+		t.Fatalf("期望 errTUNRestoreFailed，实际 %v", err)
+	}
+	if atomic.LoadInt32(&restartCalled) != 0 {
+		t.Fatal("恢复系统代理失败后不能继续重启内核")
+	}
+
+	svc.mu.RLock()
+	tunOn, proxyOn, bk, changing := svc.tunOn, svc.proxyOn, svc.backup, svc.tunChanging
+	svc.mu.RUnlock()
+	if tunOn || proxyOn || changing {
+		t.Fatalf("失败后状态不符: tunOn=%v proxyOn=%v changing=%v", tunOn, proxyOn, changing)
+	}
+	if !bk.Saved || !bk.Pending {
+		t.Fatalf("必须保留 Pending 备份: %+v", bk)
+	}
+	st, ok := readState(t, svc)
+	if !ok || !st.Pending {
+		t.Fatalf("磁盘备份必须保留并标记 Pending: %+v", st)
+	}
+}
+
+// TUN 关闭失败：不能错误宣告"系统代理已恢复"。
+func TestTUNDisableFailureDoesNotRestoreProxy(t *testing.T) {
+	fake := &fakeRegistry{server: "", enabled: false}
+	svc := newC1Service(t, fake)
+	svc.tunOn = true
+	svc.tunPrevProxyOn = true
+	svc.proxyOn = false
+
+	var alive int32 = 1
+	svc.kernelRunningFn = func() bool { return atomic.LoadInt32(&alive) == 1 }
+	restart := func() error {
+		atomic.StoreInt32(&alive, 0)
+		return errors.New("injected restart failure")
+	}
+	beforeEnable := fake.enableCalls
+
+	err := svc.setTUN(false, restart)
+	if err == nil {
+		t.Fatal("关闭 TUN 失败时必须返回错误")
+	}
+	svc.mu.RLock()
+	tunOn, proxyOn, prev, restore := svc.tunOn, svc.proxyOn, svc.tunPrevProxyOn, svc.restoreProxy
+	svc.mu.RUnlock()
+	if tunOn {
+		t.Fatal("内核已停时不能宣称 TUN 仍开启")
+	}
+	if proxyOn {
+		t.Fatal("关闭 TUN 失败时不能宣称系统代理已恢复")
+	}
+	if !prev {
+		t.Fatal("恢复意图必须保留，供下次启动继续处理")
+	}
+	if !restore {
+		t.Fatal("失败后必须把恢复意图写入启动恢复流程")
+	}
+	if fake.enableCalls != beforeEnable {
+		t.Fatal("失败路径不应写注册表开启代理")
+	}
+}
+
+// TUN 关闭成功：按记录恢复系统代理接管。
+func TestTUNDisableSuccessRestoresProxy(t *testing.T) {
+	fake := &fakeRegistry{server: "", enabled: false}
+	svc := newC1Service(t, fake)
+	svc.tunOn = true
+	svc.tunPrevProxyOn = true
+	svc.proxyOn = false
+
+	if err := svc.setTUN(false, func() error { return nil }); err != nil {
+		t.Fatalf("关闭 TUN 失败: %v", err)
+	}
+	svc.mu.RLock()
+	tunOn, proxyOn, prev := svc.tunOn, svc.proxyOn, svc.tunPrevProxyOn
+	svc.mu.RUnlock()
+	if tunOn || !proxyOn || prev {
+		t.Fatalf("关闭后状态不符: tunOn=%v proxyOn=%v prev=%v", tunOn, proxyOn, prev)
+	}
+	if !fake.enabled || fake.server != "127.0.0.1:17890" {
+		t.Fatalf("系统代理未恢复接管: enabled=%v server=%s", fake.enabled, fake.server)
+	}
+}
+
+// 内核未运行时关闭 TUN：不能当场接管代理，但恢复意图必须留给下次启动。
+func TestTUNDisableWithoutKernelPersistsRestoreIntent(t *testing.T) {
+	fake := &fakeRegistry{server: "", enabled: false}
+	svc := newC1Service(t, fake)
+	svc.tunOn = true
+	svc.tunPrevProxyOn = true
+	svc.kernelRunningFn = func() bool { return false }
+
+	if err := svc.setTUN(false, func() error {
+		t.Fatal("内核未运行时不应当调用重启")
+		return nil
+	}); err != nil {
+		t.Fatalf("关闭 TUN 失败: %v", err)
+	}
+	svc.mu.RLock()
+	tunOn, restore := svc.tunOn, svc.restoreProxy
+	svc.mu.RUnlock()
+	if tunOn {
+		t.Fatal("TUN 应已关闭")
+	}
+	if !restore {
+		t.Fatal("内核未运行时必须把代理恢复意图写入启动恢复流程")
+	}
+	if fake.enableCalls != 0 {
+		t.Fatal("内核未运行不应写注册表")
+	}
+}
+
+// reconcileProxy 在 TUN 切换期间必须跳过，不能把系统代理重新打开。
+func TestReconcileSkippedDuringTUNToggle(t *testing.T) {
+	fake := &fakeRegistry{server: "127.0.0.1:17890", enabled: true, override: "ours"}
+	svc := tunService(t, fake)
+
+	svc.mu.Lock()
+	svc.tunChanging = true
+	svc.tunTarget = true
+	svc.mu.Unlock()
+	beforeEnable := fake.enableCalls
+
+	svc.reconcileProxy()
+
+	if fake.enableCalls != beforeEnable {
+		t.Fatal("TUN 切换期间 reconcileProxy 不得写注册表")
+	}
+	if !fake.enabled || fake.server != "127.0.0.1:17890" {
+		t.Fatal("TUN 切换期间 reconcileProxy 改变了注册表")
+	}
+}
diff --git a/config_files.go b/config_files.go
new file mode 100644
index 0000000..cf1c5fa
--- /dev/null
+++ b/config_files.go
@@ -0,0 +1,99 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"time"
+)
+
+// currentConfigVersion 是本程序写出的配置格式版本。
+// 读取到更高版本说明用户降级了程序：不能按旧结构解释，更不能覆盖。
+const currentConfigVersion = 1
+
+// configReadState 区分配置文件的各种异常情况，避免把损坏当成空配置。
+type configReadState string
+
+const (
+	configMissing     configReadState = "missing"     // 文件不存在，属于正常首次启动
+	configEmpty       configReadState = "empty"       // 文件存在但内容为空/只有空白（通常是截断）
+	configCorrupt     configReadState = "corrupt"     // JSON 解析失败
+	configUnsupported configReadState = "unsupported" // 版本高于当前程序
+	configOK          configReadState = "ok"
+)
+
+// readConfigJSON 读取并解析一个 JSON 配置文件。
+//
+// 与直接 json.Unmarshal 的区别：明确区分"不存在"（可以安全地当作首次启动）
+// 与"空文件/损坏"（绝不能静默当作空配置继续，否则下一次保存会覆盖用户数据）。
+func readConfigJSON(path string, dst any) (configReadState, error) {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return configMissing, nil
+		}
+		return configCorrupt, err
+	}
+	b = bytes.TrimPrefix(b, []byte{0xEF, 0xBB, 0xBF})
+	if len(bytes.TrimSpace(b)) == 0 {
+		return configEmpty, nil
+	}
+	if err := json.Unmarshal(b, dst); err != nil {
+		return configCorrupt, err
+	}
+	return configOK, nil
+}
+
+// preserveCorruptFile 把损坏的配置改名保留，返回备份路径。
+// 改名而不是复制：原路径必须腾空，否则后续合法保存会把损坏内容覆盖掉，
+// 用户就再也拿不回原始数据。改名失败时退化为复制，并保留原文件。
+func preserveCorruptFile(path string) (string, error) {
+	backup := fmt.Sprintf("%s.corrupt-%s", path, time.Now().Format("20060102-150405"))
+	if err := os.Rename(path, backup); err == nil {
+		return backup, nil
+	} else if data, rerr := os.ReadFile(path); rerr == nil {
+		if werr := os.WriteFile(backup, data, 0o600); werr != nil {
+			return "", fmt.Errorf("备份损坏文件失败: %w", werr)
+		}
+		return backup, err
+	}
+	return "", fmt.Errorf("无法保留损坏文件")
+}
+
+// reportConfigProblem 统一记录配置异常：写 debug.log 并在界面启动错误里提示。
+// 必须让用户知道"配置没被读取"，而不是以为自己的规则/订阅凭空消失了。
+func (s *CoreService) reportConfigProblem(path string, state configReadState, cause error) {
+	name := filepath.Base(path)
+	var desc string
+	switch state {
+	case configEmpty:
+		desc = "内容为空或已被截断"
+	case configCorrupt:
+		desc = "格式损坏"
+	case configUnsupported:
+		desc = fmt.Sprintf("版本高于当前程序（支持 %d）", currentConfigVersion)
+	default:
+		return
+	}
+
+	backup, berr := preserveCorruptFile(path)
+	msg := fmt.Sprintf("配置文件 %s %s，已停止使用", name, desc)
+	if backup != "" {
+		msg += "，原文件已备份为 " + filepath.Base(backup)
+	}
+	if cause != nil {
+		msg += "（" + cause.Error() + "）"
+	}
+	if berr != nil {
+		msg += "；" + berr.Error()
+	}
+	s.dbg("%s", msg)
+	s.appendBootErr(msg)
+}
+
+// configVersionUnsupported 判断一个已解析配置的版本是否超出当前程序能力。
+func configVersionUnsupported(version int) bool {
+	return version > currentConfigVersion
+}
